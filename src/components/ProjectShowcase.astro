      category: "lam-nhom",
      image: "/projects/new-project-1.jpg",
      desc: "Hệ trần lam nhôm U-Shaped vân gỗ hoàn thiện sắc nét tại sảnh chính công trình."
    },
    {
      id: 11,
      title: "Thi công vách ngăn thạch cao tiêu âm phòng hội nghị",
      category: "thach-cao",
      image: "/projects/new-project-2.jpg",
      desc: "Hệ thống vách thạch cao Knauf Đức xử lý tiêu âm hiệu quả, nhẵn mịn thẩm mỹ cao."
    },
    {
      id: 12,
      title: "Hoàn thiện trần nhôm caro nghệ thuật",
      category: "lam-nhom",
      image: "/projects/new-project-3.jpg",
      desc: "Hệ trần caro nhôm (Cell) lắp đặt phối hợp đèn âm trần hiện đại, thông thoáng."
    },
    {
