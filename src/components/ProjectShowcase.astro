      image: "/projects/new-project-4.jpg",
      desc: "Hệ khung xương cá chắc chắn, khoảng cách đạt tiêu chuẩn chịu lực an toàn."
    },
    {
      id: 14,
      title: "Trần thạch cao giật cấp hiện đại căn hộ biển",
      category: "thach-cao",
      image: "/projects/new-project-5.jpg",
      desc: "Thi công giật cấp hắt đèn trang trí tinh tế cho phòng khách căn hộ view biển."
    },
    {
      id: 15,
      title: "Lam gỗ nhựa trang trí vách hành lang resort",
      category: "noi-that",
      image: "/projects/new-project-6.jpg",
      desc: "Ốp lam gỗ nhựa ngoài trời chịu nắng mưa cực tốt, phong cách nghỉ dưỡng sang trọng."
    },
    {
      id: 16,
      title: "Ốp vách nhựa Nano vân đá sảnh khách sạn",
      category: "noi-that",
      image: "/projects/new-project-7.jpg",
      desc: "Tấm nhựa giả đá cao cấp kết hợp nẹp đồng vàng tạo điểm nhấn vô cùng ấn tượng."
    },
    {
      id: 17,
      title: "Lắp đặt lam chắn nắng mặt tiền nhà hướng Tây",
      category: "lam-nhom",
      image: "/projects/new-project-8.jpg",
      desc: "Hệ lam nhôm chuyển động cản bức xạ nhiệt trực tiếp, làm mát ngôi nhà hiệu quả."
    },
    {
      id: 18,
      title: "Thi công trần thạch cao chống ẩm khu vực bếp",
      category: "thach-cao",
      image: "/projects/new-project-9.jpg",
      desc: "Sử dụng tấm thạch cao Gyproc chống ẩm chất lượng cao, bền bỉ cùng thời gian."
    }
  ];

  let activeFilter = "all";
  let visibleProjects = [...projectsData];
  let currentImageIdx = 0;

  // DOM Elements
  const filterButtons = document.querySelectorAll(".filter-btn");
  const projectCards = document.querySelectorAll(".project-card");
  const modal = document.getElementById("lightbox-modal");

  // Di chuyển modal ra ngoài body để tránh lỗi stacking context z-index
  if (modal) {
    document.body.appendChild(modal);
  }

  const modalImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const modalTitle = document.getElementById("lightbox-title");
  const modalDesc = document.getElementById("lightbox-desc");
  const modalClose = document.getElementById("lightbox-close");
  const modalPrev = document.getElementById("lightbox-prev");
  const modalNext = document.getElementById("lightbox-next");

  // Filtering Logic
  filterButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      const cat = btn.getAttribute("data-category") || "all";
      activeFilter = cat;

      // Update button styles
      filterButtons.forEach(b => {
        b.classList.remove("bg-gradient-to-r", "from-brand-primary", "to-brand-orange", "text-white", "shadow-lg", "shadow-brand-primary/35");
        b.classList.add("bg-white", "text-text-base", "border-stone-200/60");
      });
      btn.classList.add("bg-gradient-to-r", "from-brand-primary", "to-brand-orange", "text-white", "shadow-lg", "shadow-brand-primary/35");
      btn.classList.remove("bg-white", "text-text-base", "border-stone-200/60");

      // Filter grid cards
      projectCards.forEach(card => {
        const cardCat = card.getAttribute("data-category");
        if (cat === "all" || cardCat === cat) {
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      });

      // Update visible projects for lightbox slideshow
      visibleProjects = cat === "all"
        ? projectsData
        : projectsData.filter(p => p.category === cat);
    });
  });

  // Lightbox Logic
  function openLightbox(id: number) {
    const idx = visibleProjects.findIndex(p => p.id === id);
    if (idx === -1) return;

    currentImageIdx = idx;
    updateLightboxContent();

    modal?.classList.remove("opacity-0", "pointer-events-none");
    modal?.classList.add("opacity-100");
    document.body.style.overflow = "hidden";

    // Hide header so lightbox overlay fully covers it
    const header = document.getElementById("main-header");
    if (header) header.style.visibility = "hidden";
  }

  function closeLightbox() {
    modal?.classList.remove("opacity-100");
    modal?.classList.add("opacity-0", "pointer-events-none");
    document.body.style.overflow = "";

    // Restore header visibility
    const header = document.getElementById("main-header");
    if (header) header.style.visibility = "";
  }

  function updateLightboxContent() {
    const proj = visibleProjects[currentImageIdx];
    if (!proj) return;

    if (modalImg) modalImg.src = proj.image;
    if (modalTitle) modalTitle.textContent = proj.title;
    if (modalDesc) modalDesc.textContent = proj.desc;
  }

  function nextImage() {
    if (visibleProjects.length === 0) return;
    currentImageIdx = (currentImageIdx + 1) % visibleProjects.length;
    updateLightboxContent();
  }

  function prevImage() {
    if (visibleProjects.length === 0) return;
    currentImageIdx = (currentImageIdx - 1 + visibleProjects.length) % visibleProjects.length;
    updateLightboxContent();
  }

  // Click on card triggers Lightbox
  projectCards.forEach(card => {
    const imgContainer = card.querySelector(".project-img-container");
    const id = parseInt(card.getAttribute("data-id") || "0");
    imgContainer?.addEventListener("click", () => {
      openLightbox(id);
    });
  });

  // Close and arrow listeners
  modalClose?.addEventListener("click", closeLightbox);
  modalNext?.addEventListener("click", nextImage);
  modalPrev?.addEventListener("click", prevImage);

  // Close lightbox on clicking backdrop (outside image box)
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeLightbox();
    }
  });

  // Keyboard Navigation
  window.addEventListener("keydown", (e) => {
    if (!modal?.classList.contains("opacity-100")) return;

    if (e.key === "Escape") {
      closeLightbox();
    } else if (e.key === "ArrowRight") {
      nextImage();
    } else if (e.key === "ArrowLeft") {
      prevImage();
    }
  });
</script>
