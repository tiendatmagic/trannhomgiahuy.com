const categories = [
  { id: "all", name: "Tất cả công trình" },
  { id: "lam-nhom", name: "Trần & Lam nhôm" },
  { id: "thach-cao", name: "Trần & Vách thạch cao" },
  { id: "noi-that", name: "Trần gỗ nghệ thuật" }
];
---

<div class="space-y-12">
  <!-- Pill Filter Buttons - Vibrant Gradient styles (for buttons, gradients are allowed) -->
  <div class="flex flex-wrap justify-center gap-3">
    {categories.map((cat, idx) => (
      <button
        class={`filter-btn px-6 py-3 rounded-full font-display font-black text-xs lg:text-base uppercase tracking-wider transition-all duration-300 cursor-pointer ${
          idx === 0
            ? "bg-gradient-to-r from-brand-primary to-brand-orange text-white shadow-lg shadow-brand-primary/35 active:scale-95"
            : "bg-white text-text-base hover:bg-gradient-to-r hover:from-brand-primary hover:to-brand-orange hover:text-white hover:shadow-lg border border-stone-200/60 active:scale-95"
        }`}
        data-category={cat.id}
      >
        {cat.name}
      </button>
    ))}
  </div>

  <!-- Rounded Project Grid -->
  <div id="project-grid" class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-8">
    {projects.map((proj) => (
      <div
        class="project-card group rounded-2xl sm:rounded-[2rem] bg-white border border-stone-200/60 shadow-sm hover:shadow-md hover:border-brand-primary transition-all duration-300 flex flex-col justify-between overflow-hidden cursor-pointer"
        data-category={proj.category}
        data-id={proj.id}
      >
        <!-- Card Image with Hover Overlay -->
        <div class="relative aspect-[4/3] bg-stone-100 overflow-hidden project-img-container">
          <img
            src={proj.image}
            alt={proj.title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-108"
            loading="lazy"
          />
          <!-- Glass Overlay for Image magnifying -->
          <div class="absolute inset-0 bg-brand-primary-deep/30 backdrop-blur-xs opacity-0 group-hover:opacity-100 flex items-center justify-center transition-all duration-300">
            <span class="size-12 rounded-full bg-white text-brand-primary-deep flex items-center justify-center text-lg shadow-xl scale-90 group-hover:scale-100 transition-transform duration-300">
              <i class="fa-solid fa-magnifying-glass-plus"></i>
            </span>
          </div>
        </div>

        <!-- Card Content (Removed Tags completely) -->
        <div class="p-3 sm:p-4 lg:p-5 flex-grow flex flex-col justify-between space-y-2 sm:space-y-3">
          <div class="space-y-1.5">
            <h4 class="font-display font-semibold text-base sm:text-lg lg:text-xl text-text-base leading-tight group-hover:text-brand-primary transition-colors line-clamp-2">
              {proj.title}
            </h4>
            <p class="text-[13px] sm:text-xs lg:text-sm text-text-muted leading-relaxed line-clamp-3">
              {proj.desc}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Fullscreen Lightbox Modal - z-[9999] to cover fixed header -->
  <div id="lightbox-modal" class="fixed inset-0 z-[9999] bg-black/90 flex flex-col items-center justify-center p-4 md:p-8 opacity-0 pointer-events-none transition-opacity duration-300">
    <button id="lightbox-close" class="absolute top-4 right-4 md:top-6 md:right-6 size-12 flex items-center justify-center bg-white/10 text-white rounded-full border border-white/20 hover:bg-brand-orange hover:text-white transition-colors shadow-2xl cursor-pointer" aria-label="Đóng thư viện">
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>

    <!-- Navigation Arrows -->
    <button id="lightbox-prev" class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 size-12 flex items-center justify-center bg-white/10 text-white rounded-full border border-white/20 hover:bg-brand-orange hover:text-white transition-all hover:scale-105 active:scale-95 shadow-2xl cursor-pointer" aria-label="Hình trước">
      <i class="fa-solid fa-chevron-left"></i>
    </button>

    <button id="lightbox-next" class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 size-12 flex items-center justify-center bg-white/10 text-white rounded-full border border-white/20 hover:bg-brand-orange hover:text-white transition-all hover:scale-105 active:scale-95 shadow-2xl cursor-pointer" aria-label="Hình sau">
      <i class="fa-solid fa-chevron-right"></i>
    </button>

    <!-- Image & Caption Container -->
    <div class="max-w-4xl w-full flex flex-col items-center space-y-6">
      <div class="relative bg-white/5 p-2 rounded-3xl border border-white/10 shadow-2xl max-h-[70vh] flex items-center justify-center overflow-hidden">
        <img id="lightbox-img" src="" alt="Project Image" class="max-w-full max-h-[66vh] rounded-2xl object-contain" />
      </div>
      <div class="text-center text-white max-w-2xl px-4 space-y-2">
        <h4 id="lightbox-title" class="font-display font-semibold text-lg md:text-xl text-brand-accent"></h4>
        <p id="lightbox-desc" class="text-xs md:text-base text-white/70 leading-relaxed"></p>
      </div>
    </div>
  </div>
</div>

