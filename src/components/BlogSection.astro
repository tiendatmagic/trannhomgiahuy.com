  // DOM Elements
  const slider = document.getElementById("blog-slider");
  const prevBtn = document.getElementById("blog-prev");
  const nextBtn = document.getElementById("blog-next");

  if (slider) {
    const cards = slider.querySelectorAll('.blog-card');
    const totalCards = cards.length;
    const cardsPerGroup = totalCards / 3; // 8 cards per group

    const card0 = cards[0] as HTMLElement;
    const card8 = cards[cardsPerGroup] as HTMLElement;

    let groupWidth = 0;

    function updateDimensions() {
      if (card0 && card8) {
        groupWidth = card8.offsetLeft - card0.offsetLeft;
      }
    }

    // Initialize dimensions
    updateDimensions();
    window.addEventListener('resize', updateDimensions);

    // Position the scroll inside the middle group on page load
    function initScrollPosition() {
      updateDimensions();
      if (slider && card8) {
        slider.style.scrollBehavior = 'auto';
        slider.scrollLeft = card8.offsetLeft - slider.offsetLeft;
        // Restore smooth scroll
        requestAnimationFrame(() => {
          if (slider) slider.style.scrollBehavior = 'smooth';
        });
      }
    }

    // Run positioning logic
    initScrollPosition();
    window.addEventListener('load', initScrollPosition);

    // Infinite loop scroll listener
    let isJumping = false;
    slider.addEventListener('scroll', () => {
      if (groupWidth === 0 || isJumping) return;

      const currentScroll = slider.scrollLeft;

      // Scrolled too far left (into Group 1)
      if (currentScroll < groupWidth - 10) {
        isJumping = true;
        slider.style.scrollBehavior = 'auto';
        slider.scrollLeft = currentScroll + groupWidth;
        requestAnimationFrame(() => {
          if (slider) slider.style.scrollBehavior = 'smooth';
          isJumping = false;
        });
      }
      // Scrolled too far right (into Group 3)
      else if (currentScroll > (groupWidth * 2) - 10) {
        isJumping = true;
        slider.style.scrollBehavior = 'auto';
        slider.scrollLeft = currentScroll - groupWidth;
        requestAnimationFrame(() => {
          if (slider) slider.style.scrollBehavior = 'smooth';
          isJumping = false;
        });
      }
    });

    // Arrow Button handlers with smooth scrolling
    if (prevBtn && nextBtn) {
      prevBtn.addEventListener("click", () => {
        const card = slider.firstElementChild as HTMLElement;
        if (!card) return;
        const computedGap = window.getComputedStyle(slider).gap || window.getComputedStyle(slider).columnGap;
        const gap = computedGap && computedGap !== 'normal'
          ? parseFloat(computedGap)
          : (window.innerWidth >= 768 ? 24 : 16);
        const scrollAmount = card.offsetWidth + gap;

        slider.scrollBy({ left: -scrollAmount, behavior: "smooth" });
      });

      nextBtn.addEventListener("click", () => {
        const card = slider.firstElementChild as HTMLElement;
        if (!card) return;
        const computedGap = window.getComputedStyle(slider).gap || window.getComputedStyle(slider).columnGap;
        const gap = computedGap && computedGap !== 'normal'
          ? parseFloat(computedGap)
          : (window.innerWidth >= 768 ? 24 : 16);
        const scrollAmount = card.offsetWidth + gap;

        slider.scrollBy({ left: scrollAmount, behavior: "smooth" });
      });
    }

    // Interactive mouse drag support for desktop (intuitive swiping)
    let isDown = false;
    let startX: number;
    let scrollLeft: number;

    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      slider.style.scrollBehavior = 'auto'; // Disable smooth transition during drag
      slider.style.cursor = 'grabbing';
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });

    slider.addEventListener('mouseleave', () => {
      if (isDown) {
        isDown = false;
        slider.style.scrollBehavior = 'smooth';
        slider.style.cursor = 'grab';
      }
    });

    slider.addEventListener('mouseup', () => {
      if (isDown) {
        isDown = false;
        slider.style.scrollBehavior = 'smooth';
        slider.style.cursor = 'grab';
      }
    });

    slider.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 1.5; // Drag sensitivity multiplier
      slider.scrollLeft = scrollLeft - walk;
    });
  }

  // Modal logic
  const modal = document.getElementById("blog-modal");
  const modalContent = document.getElementById("blog-modal-content");
  const modalClose = document.getElementById("blog-modal-close");
  const modalTitle = document.getElementById("modal-post-title");
  const modalDate = document.getElementById("modal-post-date");
  const modalBody = document.getElementById("modal-post-body");
  const articleCards = document.querySelectorAll(".blog-card");

  // Move modal to body to avoid z-index/stacking context issues
  if (modal) {
    document.body.appendChild(modal);
  }

  function openPost(id: number) {
    const post = postsData.find((p) => p.id === id);
    if (
      !post ||
      !modal ||
      !modalContent ||
      !modalTitle ||
      !modalDate ||
      !modalBody
    )
      return;

    modalTitle.textContent = post.title;
    modalDate.textContent = post.date;
    modalBody.innerHTML = post.content;

    modal.classList.remove("opacity-0", "pointer-events-none");
    modal.classList.add("opacity-100");
    modalContent.classList.remove("scale-95");
    modalContent.classList.add("scale-100");
    document.body.style.overflow = "hidden";

    // Hide main header so modal covers everything
    const header = document.getElementById("main-header");
    if (header) header.style.visibility = "hidden";
  }

  function closePost() {
    if (!modal || !modalContent) return;

    modal.classList.remove("opacity-100");
    modal.classList.add("opacity-0", "pointer-events-none");
    modalContent.classList.remove("scale-100");
    modalContent.classList.add("scale-95");
    document.body.style.overflow = "";

    // Restore header
    const header = document.getElementById("main-header");
    if (header) header.style.visibility = "";
  }

  // Bind click event to each article card
  articleCards.forEach((article) => {
    article.addEventListener("click", () => {
      const id = parseInt(article.getAttribute("data-post-id") || "0");
      if (id > 0) openPost(id);
    });
  });

  modalClose?.addEventListener("click", closePost);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closePost();
  });

  window.addEventListener("keydown", (e) => {
    if (modal?.classList.contains("opacity-100") && e.key === "Escape") {
      closePost();
    }
  });
</script>
