---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Liên Hệ & Yêu Cầu Khảo Sát";
const pageSubtitle = "Để lại thông tin hoặc liên hệ trực tiếp với chúng tôi để nhận dịch vụ đo đạc hiện trạng lập dự toán báo giá miễn phí 100% tại Nha Trang.";
---

<Layout title="Liên hệ báo giá thi công trần nhôm thạch cao Nha Trang - Gia Huy">
  <!-- Page Hero Banner - High Contrast Geometric Style -->
  <div class="relative pt-44 pb-24 md:pt-52 md:pb-32 bg-gradient-to-b from-brand-primary-deep via-stone-950/95 to-stone-950 text-white overflow-hidden border-b border-brand-primary/20">
    <!-- Background visual - Parallax lines and blur orb -->
    <div class="absolute inset-0 z-0">
      <img
        src="/projects/project-9.png"
        alt="Liên hệ Trần Nhôm Gia Huy"
        class="w-full h-full object-cover opacity-65 select-none pointer-events-none scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-tr from-stone-950/75 via-brand-primary-deep/30 to-brand-orange/25"></div>
      <div class="glow-orb glow-orange w-[300px] h-[300px] -left-20 top-[-20px] opacity-30 animate-float"></div>
      <div class="glow-orb glow-yellow w-[300px] h-[300px] -right-20 bottom-[-20px] opacity-25 animate-float-reverse"></div>
      <!-- Geometric accent lines -->
      <div class="absolute right-[10%] bottom-0 w-[1px] h-[150px] bg-gradient-to-t from-brand-primary to-transparent opacity-40 hidden md:block"></div>
      <div class="absolute right-[15%] bottom-0 w-[1px] h-[250px] bg-gradient-to-t from-brand-orange to-transparent opacity-20 hidden md:block"></div>
    </div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 text-center lg:text-left space-y-6">
      <nav class="flex justify-center lg:justify-start items-center gap-2 text-xs md:text-sm font-semibold tracking-widest uppercase text-white/50">
        <a href="/" class="hover:text-brand-accent transition-colors flex items-center gap-1"><i class="fa-solid fa-house text-[10px]"></i> Trang chủ</a>
        <span class="text-white/30">•</span>
        <span class="text-brand-accent">Liên hệ</span>
      </nav>
      <div class="max-w-full space-y-4">
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-display font-black uppercase tracking-tight leading-tight text-white max-w-full">
          {pageTitle}
        </h1>
        <p class="text-sm md:text-lg text-white/80 font-medium leading-relaxed max-w-2xl">
          {pageSubtitle}
        </p>
      </div>
    </div>
  </div>

  <!-- Contact Form & Details Section - Spacious and Premium -->
  <section
    id="lien-he"
    class="py-12 md:py-[60px] relative overflow-hidden bg-bg-base"
  >
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div class="glow-orb glow-yellow w-[450px] h-[450px] -left-32 top-10 opacity-12 animate-float"></div>
      <div class="glow-orb glow-orange w-[400px] h-[400px] -right-32 top-1/2 opacity-10 animate-float-reverse"></div>
    </div>
    <div
      class="absolute inset-0 opacity-5 pointer-events-none bg-[radial-gradient(#808080_1px,transparent_1px)] bg-[size:16px_16px] z-0"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div
        class="flex flex-col lg:flex-row items-stretch justify-between gap-12 lg:gap-16"
      >
        <!-- Left Column: Contact details in clean premium cards (betraying standard box layouts) -->
        <div class="lg:w-1/2 flex flex-col justify-center space-y-8">
          <div class="space-y-4 flex flex-col items-center lg:items-start text-center lg:text-left">
            <div
              class="inline-flex items-center gap-2 bg-brand-primary/10 border border-brand-primary/20 px-4 py-1.5 rounded-full"
            >
              <p
                class="text-xs font-semibold text-brand-primary tracking-widest uppercase"
              >
                Tư vấn nhanh chóng
              </p>
            </div>

            <h2
              class="text-2xl sm:text-3xl lg:text-4xl font-display font-extrabold text-text-base leading-tight"
            >
              KẾT NỐI VỚI <span
                class="bg-clip-text text-transparent bg-gradient-to-r from-brand-primary via-brand-orange to-brand-accent inline-block"
                >CHÚNG TÔI</span
              >
            </h2>
            <p
              class="text-text-muted text-sm lg:text-base font-medium leading-relaxed max-w-md mx-auto lg:mx-0"
            >
              Quý khách có nhu cầu hoàn thiện nhà ở, văn phòng, nhà hàng, spa tại Nha Trang? Hãy gọi điện, nhắn tin Zalo hoặc gửi biểu mẫu để được khảo sát thực tế và báo giá sớm nhất.
            </p>
          </div>

          <!-- Vertical stack of contact widgets (Premium Minimalist Cards) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 relative z-10">
            <!-- Hotline -->
            <div
              class="bg-white/90 backdrop-blur-xl border border-stone-200/50 p-6 rounded-[2.5rem] flex items-center gap-4 hover:shadow-xl hover:border-brand-primary/50 hover:shadow-[0_20px_50px_rgba(217,119,6,0.12)] transition-all duration-300 group border-b-2 border-b-brand-primary animate-fade-in"
            >
              <span
                class="grid size-12 place-items-center bg-brand-primary/10 text-brand-primary rounded-2xl text-xl shrink-0 group-hover:bg-brand-primary group-hover:text-white transition-all duration-300"
              >
                <i class="fa-solid fa-phone"></i>
              </span>
              <div>
                <p
                  class="text-[10px] font-bold uppercase tracking-wider text-text-muted"
                >
                  HOTLINE &amp; ZALO
                </p>
                <a
                  href="tel:0935373577"
                  class="text-base font-extrabold text-text-base hover:text-brand-primary transition-colors"
                  >0935.37.3577</a
                >
              </div>
            </div>

            <!-- Email -->
            <div
              class="bg-white/90 backdrop-blur-xl border border-stone-200/50 p-6 rounded-[2.5rem] flex items-center gap-4 hover:shadow-xl hover:border-brand-orange/50 hover:shadow-[0_20px_50px_rgba(249,115,22,0.12)] transition-all duration-300 group border-t-2 border-t-brand-orange animate-fade-in"
            >
              <span
                class="grid size-12 place-items-center bg-brand-orange/10 text-brand-orange rounded-2xl text-xl shrink-0 group-hover:bg-brand-orange group-hover:text-white transition-all duration-300"
              >
                <i class="fa-solid fa-envelope"></i>
              </span>
              <div>
                <p
                  class="text-[10px] font-bold uppercase tracking-wider text-text-muted"
                >
                  EMAIL LIÊN HỆ
                </p>
                <span class="text-xs font-bold text-text-base break-all"
                  >trannhomgiahuy.nt@gmail.com</span
                >
              </div>
            </div>

            <!-- Website -->
            <div
              class="bg-white/90 backdrop-blur-xl border border-stone-200/50 p-6 rounded-[2.5rem] flex items-center gap-4 hover:shadow-xl hover:border-brand-green/50 hover:shadow-[0_20px_50px_rgba(34,197,94,0.12)] transition-all duration-300 group border-b-2 border-b-brand-green animate-fade-in"
            >
              <span
                class="grid size-12 place-items-center bg-brand-green/10 text-brand-green rounded-2xl text-xl shrink-0 group-hover:bg-brand-green group-hover:text-white transition-all duration-300"
              >
                <i class="fa-solid fa-globe"></i>
              </span>
              <div>
                <p
                  class="text-[10px] font-bold uppercase tracking-wider text-text-muted"
                >
                  TRANG WEB CHÍNH
                </p>
                <a
                  href="/"
                  class="text-base font-bold text-text-base hover:text-brand-primary transition-colors"
                  >trannhomgiahuy.com</a
                >
              </div>
            </div>

            <!-- Address -->
            <div
              class="bg-white/90 backdrop-blur-xl border border-stone-200/50 p-6 rounded-[2.5rem] flex items-center gap-4 hover:shadow-xl hover:border-brand-blue/50 hover:shadow-[0_20px_50px_rgba(59,130,246,0.12)] transition-all duration-300 group border-t-2 border-t-brand-blue animate-fade-in"
            >
              <span
                class="grid size-12 place-items-center bg-brand-blue/10 text-brand-blue rounded-2xl text-xl shrink-0 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300"
              >
                <i class="fa-solid fa-map-location-dot"></i>
              </span>
              <div>
                <p
                  class="text-[10px] font-bold uppercase tracking-wider text-text-muted"
                >
                  ĐỊA CHỈ TRỰC TIẾP
                </p>
                <span class="text-xs sm:text-sm font-bold text-text-base"
                  >Vĩnh Lương, TP. Nha Trang, Khánh Hòa</span
                >
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Consultation Form card - generous spacing & thin input lines with active glow -->
        <div class="lg:w-1/2 flex items-center relative z-10">
          <div
            class="bg-white/90 backdrop-blur-xl border border-stone-200/50 rounded-[2.5rem] p-6 sm:p-10 shadow-2xl w-full hover:border-brand-primary/30 transition-colors"
          >
            <h3
              class="font-display font-extrabold text-xl sm:text-2xl lg:text-3xl text-center text-text-base uppercase tracking-tight mb-8"
            >
              Gửi thông tin cho chúng tôi
            </h3>

            <form id="contact-form" class="space-y-6">
              <!-- Name -->
              <div class="flex flex-col gap-2">
                <label
                  for="fullname"
                  class="font-display font-semibold text-xs sm:text-sm uppercase text-text-base tracking-wider pl-2"
                  >Họ và tên <span class="text-red-500">*</span></label
                >
                <input
                  type="text"
                  id="fullname"
                  name="fullname"
                  required
                  placeholder="Nguyễn Văn A"
                  class="px-5 py-3.5 border border-stone-200/80 rounded-2xl bg-white/70 text-text-base font-sans text-sm sm:text-base focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-4 focus:ring-brand-primary/10 transition-all duration-300 shadow-sm"
                />
              </div>

              <!-- Phone -->
              <div class="flex flex-col gap-2">
                <label
                  for="phone"
                  class="font-display font-semibold text-xs sm:text-sm uppercase text-text-base tracking-wider pl-2"
                  >Số điện thoại <span class="text-red-500">*</span></label
                >
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="0935.37.3577"
                  class="px-5 py-3.5 border border-stone-200/80 rounded-2xl bg-white/70 text-text-base font-sans text-sm sm:text-base focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-4 focus:ring-brand-primary/10 transition-all duration-300 shadow-sm"
                />
              </div>

              <!-- Service category dropdown -->
              <div class="flex flex-col gap-2">
                <label
                  for="service-type"
                  class="font-display font-semibold text-xs sm:text-sm uppercase text-text-base tracking-wider pl-2"
                  >Dịch vụ cần tư vấn</label
                >
                <select
                  id="service-type"
                  name="service-type"
                  class="px-5 py-3.5 border border-stone-200/80 rounded-2xl bg-white/70 text-text-base font-sans text-sm sm:text-base focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-4 focus:ring-brand-primary/10 transition-all duration-300 cursor-pointer shadow-sm"
                >
                  <option value="">-- Chọn dịch vụ --</option>
                  <option value="lam-nhom">Trần &amp; Lam nhôm giả gỗ</option>
                  <option value="thach-cao">Trần &amp; Vách thạch cao Knauf/Vĩnh Tường</option>
                  <option value="nhua-gia-go">Trần - Vách - Lam nhựa giả gỗ</option>
                  <option value="tron-goi">Thi công trọn gói tất cả các hạng mục</option>
                </select>
              </div>

              <!-- Message -->
              <div class="flex flex-col gap-2">
                <label
                  for="message"
                  class="font-display font-semibold text-xs sm:text-sm uppercase text-text-base tracking-wider pl-2"
                  >Nội dung cần hỗ trợ</label
                >
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  placeholder="Mô tả ngắn về công trình (ví dụ: diện tích m2, kiểu trần mong muốn)..."
                  class="px-5 py-3.5 border border-stone-200/80 rounded-2xl bg-white/70 text-text-base font-sans text-sm sm:text-base focus:outline-none focus:border-brand-primary focus:bg-white focus:ring-4 focus:ring-brand-primary/10 transition-all duration-300 resize-none shadow-sm"
                ></textarea>
              </div>

              <!-- Submit button with 3D transition and shine-effect -->
              <div class="pt-2">
                <button
                  type="submit"
                  class="w-full py-4 bg-gradient-to-r from-brand-primary to-brand-orange hover:shadow-xl hover:shadow-brand-primary/25 text-white font-display font-black text-sm sm:text-base uppercase tracking-wider rounded-full transition-all duration-300 cursor-pointer active:translate-y-0.5 border border-white/20 shadow-md shine-effect"
                >
                  <i class="fa-solid fa-paper-plane text-sm mr-2"></i> GỬI YÊU CẦU BÁO GIÁ
                </button>
              </div>
            </form>

            <!-- Form Success State (Hidden by default) -->
            <div
              id="form-success"
              class="hidden border border-brand-green bg-brand-green/5 text-brand-green p-8 rounded-[2rem] shadow-2xl text-center space-y-4 animate-float"
            >
              <span
                class="grid size-14 place-items-center bg-brand-green text-white rounded-full mx-auto text-xl shadow-lg"
              >
                <i class="fa-solid fa-check"></i>
              </span>
              <h4
                class="font-display font-bold text-lg uppercase text-brand-green"
              >
                Thông tin đã gửi thành công!
              </h4>
              <p
                class="text-xs sm:text-sm lg:text-base text-text-muted max-w-md mx-auto leading-relaxed"
              >
                Cám ơn bạn. Đội ngũ kỹ thuật Gia Huy Nha Trang đã tiếp nhận yêu cầu tư vấn và sẽ liên hệ lại trực tiếp qua số điện thoại sớm nhất.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Simple Form Submission Handler
  const form = document.getElementById("contact-form");
  const successBox = document.getElementById("form-success");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    // Simulate API request submission
    form.classList.add("hidden");
    successBox?.classList.remove("hidden");

    // Smooth scroll to success state
    successBox?.scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>
