                  class="font-display font-semibold text-sm lg:text-base uppercase text-text-base tracking-wider pl-2"
                  >Số điện thoại <span class="text-red-500">*</span></label
                >
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="0900 000 000"
                  class="px-5 py-3.5 border border-input-border rounded-xl bg-input-bg text-text-base font-sans text-base focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all duration-300"
                />
              </div>

              <!-- Service category dropdown -->
              <div class="flex flex-col gap-2">
                <label
                  for="service-type"
                  class="font-display font-semibold text-sm lg:text-base uppercase text-text-base tracking-wider pl-2"
                  >Dịch vụ quan tâm</label
                >
                <select
                  id="service-type"
                  name="service-type"
                  class="px-5 py-3.5 border border-input-border rounded-xl bg-input-bg text-text-base font-sans text-base focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all duration-300 cursor-pointer"
                >
                  <option value="">-- Chọn dịch vụ --</option>
                  <option value="lam-nhom">Trần & Lam nhôm giả gỗ</option>
                  <option value="thach-cao"
                    >Trần & Vách thạch cao Knauf/Vĩnh Tường</option
                  >
                  <option value="nhua-gia-go"
                    >Trần - Vách - Lam nhựa giả gỗ</option
                  >
                  <option value="tron-goi"
                    >Thi công trọn gói tất cả các hạng mục</option
                  >
                </select>
              </div>

              <!-- Message -->
              <div class="flex flex-col gap-2">
                <label
                  for="message"
                  class="font-display font-semibold text-sm lg:text-base uppercase text-text-base tracking-wider pl-2"
                  >Nội dung cần hỗ trợ</label
                >
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  placeholder="Mô tả ngắn về nhu cầu của bạn..."
                  class="px-5 py-3.5 border border-input-border rounded-xl bg-input-bg text-text-base font-sans text-base focus:outline-none focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 transition-all duration-300 resize-none"
                ></textarea>
              </div>

              <!-- Submit button - Synchronized to brand-primary/brand-orange gradient -->
              <div class="pt-2">
                <button
                  type="submit"
                  class="w-full py-4 bg-gradient-to-r from-brand-primary to-brand-orange hover:shadow-lg text-white font-display font-bold text-base uppercase tracking-wider rounded-xl transition-all duration-300 cursor-pointer shadow-lg hover:shadow-brand-primary/10 active:scale-[0.99] flex items-center justify-center gap-2"
                >
                  <i class="fa-solid fa-paper-plane text-base"></i> Gửi thông tin
                  ngay
                </button>
              </div>
            </form>

            <!-- Form Success State (Hidden by default) -->
            <div
              id="form-success"
              class="hidden border border-brand-green bg-brand-green/5 text-brand-green p-8 rounded-[2rem] shadow-xl text-center space-y-4 animate-float"
            >
              <span
                class="grid size-14 place-items-center bg-brand-green text-white rounded-full mx-auto text-xl shadow-lg"
              >
                <i class="fa-solid fa-check"></i>
              </span>
              <h4
                class="font-display font-bold text-lg uppercase text-brand-green"
              >
                Thông tin đã gửi thành công!
              </h4>
              <p
                class="text-sm lg:text-base text-text-muted max-w-md mx-auto leading-relaxed"
              >
                Cám ơn bạn. Đội ngũ kỹ thuật Gia Huy Nha Trang đã tiếp nhận yêu
                cầu tư vấn và sẽ liên hệ lại trực tiếp qua số điện thoại sớm
                nhất.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Simple Form Submission Handler
  const form = document.getElementById("contact-form");
  const successBox = document.getElementById("form-success");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    // Simulate API request submission
    form.classList.add("hidden");
    successBox?.classList.remove("hidden");

    // Smooth scroll to success state
    successBox?.scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>
