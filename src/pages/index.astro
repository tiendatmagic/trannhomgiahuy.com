---
import Layout from "../layouts/Layout.astro";
import ProjectShowcase from "../components/ProjectShowcase.astro";
import BlogSection from "../components/BlogSection.astro";
---

<Layout>
  <!-- Hero Section with Ambient Orbs -->
  <section
    id="top"
    class="relative overflow-hidden pt-40 lg:pt-44 pb-20 lg:pb-24 bg-bg-base transition-colors duration-300"
  >
    <!-- Ambient Floating Glow Blobs -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div
        class="glow-orb glow-yellow w-[400px] h-[400px] -left-32 top-10 opacity-20 animate-float"
      >
      </div>
      <div
        class="glow-orb glow-orange w-[500px] h-[500px] -right-32 top-[-50px] opacity-15 animate-float-reverse"
      >
      </div>
      <div
        class="glow-orb glow-green w-[300px] h-[300px] bottom-10 left-[35%] opacity-12 animate-float"
      >
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <!-- Left: Taglines, Headline with Gradient, Pill CTA buttons -->
        <div
          class="lg:w-1/2 space-y-7 text-center lg:text-left reveal-on-scroll"
        >
          <div
            class="inline-flex items-center gap-2 bg-brand-primary/10 border border-brand-primary/20 px-4 py-1.5 rounded-full mt-3"
          >
            <p
              class="text-xs font-semibold text-brand-primary tracking-widest uppercase"
            >
              Trần Nhôm Gia Huy Nha Trang
            </p>
          </div>

          <!-- Responsive Headline with customizable wrapping to prevent squishing -->
          <h1
            class="text-2xl sm:text-3xl lg:text-4xl font-display font-extrabold text-text-base leading-tight"
          >
            GIẢI PHÁP <br class="hidden md:inline" />
            <span
              class="bg-clip-text text-transparent bg-gradient-to-r from-brand-primary via-brand-orange to-brand-accent py-1.5 inline-block"
            >
              TRẦN &amp; VÁCH HIỆN ĐẠI
            </span>
          </h1>

          <p
            class="text-text-muted text-base sm:text-lg lg:text-base leading-relaxed max-w-lg mx-auto lg:mx-0 font-medium"
          >
            Thiết kế sáng tạo và thi công trọn gói hệ trần nhôm vân gỗ chống
            nước, trần thạch cao chống ẩm Knauf Đức, lam sóng gỗ nhựa trang trí
            cao cấp tại Khánh Hòa.
          </p>

          <div
            class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2"
          >
            <a
              href="#lien-he"
              class="inline-flex items-center justify-center bg-gradient-to-r from-brand-primary to-brand-orange hover:shadow-xl hover:shadow-brand-primary/25 hover:-translate-y-0.5 text-white font-display font-semibold text-sm lg:text-base px-8 py-4 rounded-full transition-all duration-300 shine-effect cursor-pointer w-full sm:w-auto text-center border border-white/20 shadow-md"
            >
              <i class="fa-solid fa-file-invoice-dollar mr-2 text-base"></i> ĐĂNG
              KÝ BÁO GIÁ
            </a>
            <a
              href="tel:0935373577"
              class="inline-flex items-center justify-center border border-brand-primary/30 hover:border-brand-primary text-brand-primary bg-white hover:bg-brand-primary/5 px-8 py-4 rounded-full font-display font-semibold text-sm lg:text-base transition-all duration-300 backdrop-blur-md cursor-pointer w-full sm:w-auto text-center"
            >
              <i class="fa-solid fa-phone mr-2"></i> GỌI TƯ VẤN 24/7
            </a>
          </div>
        </div>

        <!-- Right: Styled image container (KIGI Agency style) with real project photo -->
        <div class="lg:w-1/2 w-full relative reveal-on-scroll delay-200">
          <!-- Colorful backdrop decoration -->
          <div
            class="absolute -inset-4 bg-gradient-to-r from-brand-accent via-brand-orange to-brand-green rounded-[2.5rem] blur-3xl opacity-20 animate-pulse"
            style="animation-duration: 6s;"
          >
          </div>

          <div
            class="relative p-2 rounded-[2.5rem] border border-stone-200/60 bg-white backdrop-blur-md shadow-2xl"
          >
            <div
              class="absolute inset-0 rounded-[2.5rem] bg-gradient-to-r from-brand-primary to-brand-orange opacity-5 blur-xl pointer-events-none"
            >
            </div>
            <img
              src="/projects/project-5.png"
              alt="Thi công trần nhôm Gia Huy"
              class="w-full aspect-[4/3] object-cover rounded-[2.2rem] shadow-md border border-white/40"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badge Bar - sits below hero as its own section -->
  <section
    class="relative z-10 py-6 md:py-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"
  >
    <div
      class="bg-white/95 backdrop-blur-xl border border-stone-200/50 shadow-2xl rounded-2xl sm:rounded-[2.5rem] grid grid-cols-1 md:grid-cols-3 gap-4 p-2 sm:p-4 divide-y md:divide-y-0 md:divide-x divide-stone-200/40"
    >
      <!-- Badge 1 -->
      <div
        class="p-4 sm:p-6 flex items-center gap-4 hover:bg-brand-primary/5 transition-colors duration-300 rounded-xl sm:rounded-[2rem] group cursor-pointer reveal-on-scroll"
      >
        <span
          class="grid size-12 place-items-center bg-brand-primary/10 text-brand-primary rounded-2xl text-xl shrink-0 group-hover:scale-110 transition-transform duration-300"
        >
          <i class="fa-solid fa-shield-halved"></i>
        </span>
        <div>
          <h4
            class="font-display font-semibold text-sm lg:text-base uppercase tracking-wide text-text-base"
          >
            Vật liệu cao cấp
          </h4>
          <p class="text-xs lg:text-base text-text-muted mt-0.5">
            Đạt chuẩn bền đẹp, chống ẩm mốc
          </p>
        </div>
      </div>

      <!-- Badge 2 -->
      <div
        class="p-4 sm:p-6 flex items-center gap-4 hover:bg-brand-primary/5 transition-colors duration-300 rounded-xl sm:rounded-[2rem] group cursor-pointer reveal-on-scroll delay-100"
      >
        <span
          class="grid size-12 place-items-center bg-brand-primary/10 text-brand-primary rounded-2xl text-xl shrink-0 group-hover:scale-110 transition-transform duration-300"
        >
          <i class="fa-solid fa-screwdriver-wrench"></i>
        </span>
        <div>
          <h4
            class="font-display font-semibold text-sm lg:text-base uppercase tracking-wide text-text-base"
          >
            Thi công tỉ mỉ
          </h4>
          <p class="text-xs lg:text-base text-text-muted mt-0.5">
            Đúng kỹ thuật, đội thợ tay nghề cao
          </p>
        </div>
      </div>

      <!-- Badge 3 -->
      <div
        class="p-4 sm:p-6 flex items-center gap-4 hover:bg-brand-primary/5 transition-colors duration-300 rounded-xl sm:rounded-[2rem] group cursor-pointer reveal-on-scroll delay-200"
      >
        <span
          class="grid size-12 place-items-center bg-brand-primary/10 text-brand-primary rounded-2xl text-xl shrink-0 group-hover:scale-110 transition-transform duration-300"
        >
          <i class="fa-solid fa-award"></i>
        </span>
        <div>
          <h4
            class="font-display font-semibold text-sm lg:text-base uppercase tracking-wide text-text-base"
          >
            Báo giá tại xưởng
          </h4>
          <p class="text-xs lg:text-base text-text-muted mt-0.5">
            Không trung gian, tối ưu 20% chi phí
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Giới Thiệu / Vị Trí Hoạt Động -->
  <section
    id="gioi-thieu"
    class="py-12 md:py-[60px] relative overflow-hidden bg-bg-base transition-colors duration-300"
  >
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div
        class="glow-orb glow-green w-[300px] h-[300px] -left-20 bottom-10 opacity-10 animate-float"
      >
      </div>
      <div
        class="glow-orb glow-yellow w-[300px] h-[300px] -right-20 bottom-20 opacity-10 animate-float-reverse"
      >
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <!-- Left: Real project picture -->
        <div class="lg:w-1/2 w-full reveal-on-scroll">
          <div
            class="relative p-2 rounded-[2.5rem] border border-stone-200/60 bg-white shadow-2xl"
          >
            <!-- Glass Overlay address card -->
            <div
              class="absolute bottom-6 left-6 right-6 z-10 bg-white/90 backdrop-blur-md border border-stone-200/50 text-text-base p-3 sm:p-5 rounded-2xl shadow-xl flex items-center gap-4 max-w-[400px]"
            >
              <div
                class="size-11 bg-brand-primary/15 rounded-full flex items-center justify-center text-brand-primary text-xl shrink-0"
              >
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <div>
                <h4
                  class="font-display font-bold text-[10px] lg:text-sm uppercase tracking-wider text-text-muted"
                >
                  Khu vực hoạt động
                </h4>
                <p class="text-sm lg:text-base font-bold text-text-base mt-0.5">
                  Nha Trang - Khánh Hòa và lân cận
                </p>
              </div>
            </div>

            <img
              src="/projects/project-1.png"
              alt="Thi công trần nhôm Nha Trang"
              class="w-full h-auto aspect-[4/3] rounded-[2.2rem] object-cover shadow-inner"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Right: Content details -->
        <div
          class="lg:w-1/2 space-y-6 text-center lg:text-left reveal-on-scroll delay-200"
        >
          <div
            class="inline-flex items-center gap-2 bg-brand-primary/10 border border-brand-primary/20 px-4 py-1.5 rounded-full"
          >
            <p
              class="text-xs font-semibold text-brand-primary tracking-widest uppercase"
            >
              Về thương hiệu Gia Huy
            </p>
          </div>

          <h2
            class="text-2xl sm:text-3xl lg:text-4xl font-display font-extrabold text-text-base leading-tight"
          >
            CHUYÊN GIA THI CÔNG <span
              class="bg-clip-text text-transparent bg-gradient-to-r from-brand-primary via-brand-orange to-brand-accent py-1.5 inline-block"
              >TRẦN VÁCH UY TÍN</span
            >
          </h2>

          <div
            class="text-text-muted text-sm lg:text-base leading-relaxed space-y-4 font-medium max-w-xl mx-auto lg:mx-0"
          >
            <p>
              Gia Huy tự hào đồng hành cùng hàng trăm gia chủ và chủ đầu tư dự
              án tại Nha Trang, mang tới các sản phẩm **trần nhôm cao cấp, trần
              thạch cao, lam gỗ nhựa** bền bỉ dưới mọi khí hậu ven biển.
            </p>
            <p
              class="bg-brand-primary/5 p-4 border-l-4 border-brand-primary text-brand-primary-dark font-semibold rounded-r-xl text-left"
            >
              Chúng tôi sở hữu năng lực cung cấp trực tiếp vật tư chính hãng với
              giá cả gốc tại kho và cử thợ chuyên môn cao thi công trực tiếp
              không qua thầu phụ.
            </p>
            <p>
              Sự chính xác kỹ thuật, tính thẩm mỹ hoàn thiện cao và trách nhiệm
              bảo hành lâu dài là kim chỉ nam giúp Trần Nhôm Gia Huy khẳng định
              vị thế thương hiệu lâu đời trong ngành xây dựng hoàn thiện tại
              Khánh Hòa.
            </p>
          </div>

          <div
            class="pt-4 flex flex-wrap gap-4 justify-center lg:justify-start items-center"
          >
            <div
              class="bg-white border border-stone-200/50 rounded-2xl px-6 py-4"
            >
              <p
                class="text-[10px] lg:text-sm uppercase font-semibold text-text-muted"
              >
                Hotline Zalo 24/7
              </p>
              <a
                href="tel:0935373577"
                class="text-xl font-display font-black text-brand-primary hover:text-brand-orange transition-colors"
                >0935.37.3577</a
              >
            </div>
            <div
              class="bg-white border border-stone-200/50 rounded-2xl px-6 py-4"
            >
              <p
                class="text-[10px] lg:text-sm uppercase font-semibold text-text-muted"
              >
                Cam kết dịch vụ
              </p>
              <p
                class="text-sm lg:text-base font-display font-bold text-brand-green"
              >
                ĐẸP - ĐÚNG TIẾN ĐỘ
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee Banner between sections -->
  <section
    class="overflow-hidden border-y border-stone-200/50 bg-stone-100/50 py-6 md:py-10 transition-colors duration-300"
  >
    <div
      class="marquee-container gap-12 whitespace-nowrap text-xs sm:text-sm font-display font-semibold uppercase tracking-[0.2em] text-text-muted"
    >
      <div class="marquee-content flex gap-12">
        <span class="hover:text-brand-primary transition-colors duration-200"
          >TRẦN NHÔM GIA HUY</span
        >
        <span class="text-stone-300">•</span>
        <span class="hover:text-brand-orange transition-colors duration-200"
          >UY TÍN - THI CÔNG NHANH</span
        >
        <span class="text-stone-300">•</span>
        <span class="hover:text-brand-green transition-colors duration-200"
          >BÁO GIÁ TẠI XƯỞNG</span
        >
        <span class="text-stone-300">•</span>
        <span class="hover:text-brand-primary transition-colors duration-200"
          >TRẦN NHÔM VÂN GỖ</span
        >
        <span class="text-stone-300">•</span>
        <span class="hover:text-brand-orange transition-colors duration-200"
          >TRẦN THẠCH CAO KNAUF</span
        >
        <span class="text-stone-300">•</span>
        <span class="hover:text-brand-green transition-colors duration-200"
          >LAM SÓNG GIẢ GỖ CAO CẤP</span
        >
        <span class="text-stone-300">•</span>

        <!-- Repeat content for continuous loop -->
        <span class="hover:text-brand-primary transition-colors duration-200"
          >TRẦN NHÔM GIA HUY</span
        >
        <span class="text-stone-300">•</span>
        <span class="hover:text-brand-orange transition-colors duration-200"
          >UY TÍN - THI CÔNG NHANH</span
        >
        <span class="text-stone-300">•</span>
        <span class="hover:text-brand-green transition-colors duration-200"
          >BÁO GIÁ TẠI XƯỞNG</span
        >
        <span class="text-stone-300">•</span>
        <span class="hover:text-brand-primary transition-colors duration-200"
          >TRẦN NHÔM VÂN GỖ</span
        >
        <span class="text-stone-300">•</span>
        <span class="hover:text-brand-orange transition-colors duration-200"
          >TRẦN THẠCH CAO KNAUF</span
        >
        <span class="text-stone-300">•</span>
        <span class="hover:text-brand-green transition-colors duration-200"
          >LAM SÓNG GIẢ GỖ CAO CẤP</span
        >
      </div>
    </div>
  </section>

  <!-- Hạng Mục Thi Công - Simple White bordered cards on hover -->
  <section
    id="dich-vu"
    class="py-12 md:py-[60px] relative overflow-hidden bg-bg-base transition-colors duration-300"
  >
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div
        class="glow-orb glow-blue w-[400px] h-[400px] right-0 top-1/4 opacity-10 animate-float"
      >
      </div>
      <div
        class="glow-orb glow-yellow w-[300px] h-[300px] left-0 top-1/2 opacity-10 animate-float-reverse"
      >
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Section Header -->
      <div
        class="text-center max-w-7xl mx-auto mb-12 md:mb-16 space-y-4 reveal-on-scroll"
      >
        <div
          class="inline-flex items-center gap-2 bg-brand-primary/10 border border-brand-primary/20 px-4 py-1.5 rounded-full"
        >
          <p
            class="text-xs font-semibold text-brand-primary tracking-widest uppercase"
          >
            Hạng mục thi công cốt lõi
          </p>
        </div>
        <h2
          class="text-2xl sm:text-3xl lg:text-4xl font-display font-extrabold text-text-base"
        >
          DỊCH VỤ TRỌN GÓI TỪ <span
            class="bg-clip-text text-transparent bg-gradient-to-r from-brand-primary via-brand-orange to-brand-accent py-1.5 inline-block"
            >GIA HUY</span
          >
        </h2>
        <p
          class="text-text-muted text-sm lg:text-base font-medium max-w-xl mx-auto leading-relaxed"
        >
          Chúng tôi trực tiếp nhập khẩu, phân phối và lắp đặt các hệ trần nhôm
          trang trí, trần thạch cao chất lượng đạt tiêu chuẩn thiết kế.
        </p>
      </div>

      <!-- Card Grid wrapper with group for hover arrows -->
      <div class="relative group" id="services-wrapper">
        <!-- Left Arrow - hover only -->
        <button
          id="services-prev"
          class="absolute left-[-10px] sm:left-[-15px] top-[45%] -translate-y-1/2 size-12 hidden sm:flex items-center justify-center bg-white text-text-base rounded-full border border-stone-200/60 shadow-lg active:scale-90 hover:bg-brand-primary hover:text-white transition-all z-20 cursor-pointer opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto duration-300"
          aria-label="Dịch vụ trước"
        >
          <i class="fa-solid fa-chevron-left text-sm"></i>
        </button>

        <!-- Right Arrow - hover only -->
        <button
          id="services-next"
          class="absolute right-[-10px] sm:right-[-15px] top-[45%] -translate-y-1/2 size-12 hidden sm:flex items-center justify-center bg-white text-text-base rounded-full border border-stone-200/60 shadow-lg active:scale-90 hover:bg-brand-primary hover:text-white transition-all z-20 cursor-pointer opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto duration-300"
          aria-label="Dịch vụ sau"
        >
          <i class="fa-solid fa-chevron-right text-sm"></i>
        </button>

        <!-- Card Grid - Slider on mobile, 3 columns grid on desktop -->
        <div
          id="services-slider"
          class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory no-scrollbar sm:grid sm:grid-cols-3 sm:gap-6 lg:gap-8 sm:pb-0 sm:overflow-visible"
        >
          <!-- Card 1: Trần Thạch Cao -->
          <article
            class="min-w-[calc(50%-8px)] w-[calc(50%-8px)] shrink-0 snap-start bg-white border border-stone-200/60 hover:border-brand-primary/80 hover:shadow-[0_15px_30px_-5px_rgba(217,119,6,0.15)] rounded-2xl sm:rounded-[2rem] p-3 sm:p-5 lg:p-7 flex flex-col justify-between cursor-pointer transition-all duration-300 group hover:-translate-y-1 reveal-on-scroll sm:min-w-0 sm:w-auto"
          >
            <div class="space-y-3 md:space-y-5 flex-grow">
              <!-- Icon -->
              <div
                class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 rounded-xl sm:rounded-2xl bg-brand-primary/10 text-brand-primary group-hover:bg-brand-primary group-hover:text-white flex items-center justify-center group-hover:scale-105 transition-all duration-300"
              >
                <span class="text-lg sm:text-xl md:text-2xl font-semibold">
                  <i class="fa-solid fa-fill-drip"></i>
                </span>
              </div>
              <h3
                class="font-display font-bold text-base sm:text-lg lg:text-xl text-text-base uppercase tracking-tight group-hover:text-brand-primary transition-colors duration-200"
              >
                Trần thạch cao
              </h3>
              <p
                class="text-[13px] sm:text-xs lg:text-sm xl:text-base text-text-muted leading-relaxed font-medium"
              >
                Thi công hệ trần phẳng, giật cấp thẩm mỹ cao, cách âm cách nhiệt
                tốt. Thích hợp cho phòng khách biệt thự, căn hộ cao cấp và văn
                phòng công sở.
              </p>
              <ul
                class="space-y-2 text-[13px] sm:text-xs lg:text-sm xl:text-base text-text-base font-semibold border-t border-stone-200/50 pt-3 sm:pt-4"
              >
                <li class="flex items-start gap-2">
                  <i
                    class="fa-solid fa-circle-check text-brand-green text-[9px] mt-1 shrink-0"
                  ></i> Tấm thạch cao Knauf Đức chống ẩm
                </li>
                <li class="flex items-start gap-2">
                  <i
                    class="fa-solid fa-circle-check text-brand-green text-[9px] mt-1 shrink-0"
                  ></i> Khung xương Vĩnh Tường chịu lực
                </li>
                <li class="flex items-start gap-2">
                  <i
                    class="fa-solid fa-circle-check text-brand-green text-[9px] mt-1 shrink-0"
                  ></i> Bề mặt bả sơn nhẵn mịn tuyệt đối
                </li>
              </ul>
            </div>

            <div class="pt-3 sm:pt-4 md:pt-5">
              <a
                href="#lien-he"
                class="flex items-center justify-center gap-1.5 w-full py-2.5 sm:py-3 bg-gradient-to-r from-brand-primary to-brand-orange text-white font-display font-semibold rounded-full transition-all duration-300 shadow-md hover:shadow-lg hover:shadow-brand-primary/20 hover:-translate-y-0.5 text-xs lg:text-sm xl:text-base"
              >
                <i class="fa-solid fa-comment-dots text-xs sm:text-sm"></i>
                Nhận tư vấn
              </a>
            </div>
          </article>

          <!-- Card 2: Trần Nhôm - Lam Nhôm -->
          <article
            class="min-w-[calc(50%-8px)] w-[calc(50%-8px)] shrink-0 snap-start bg-white border border-stone-200/60 hover:border-brand-orange/80 hover:shadow-[0_15px_30px_-5px_rgba(249,115,22,0.15)] rounded-2xl sm:rounded-[2rem] p-3 sm:p-5 lg:p-7 flex flex-col justify-between cursor-pointer transition-all duration-300 group hover:-translate-y-1 reveal-on-scroll delay-100 sm:min-w-0 sm:w-auto"
          >
