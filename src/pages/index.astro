---
import Layout from '../layouts/Layout.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
---

<Layout>
  <!-- Hero Section with Glowing Background Orbs & Text Gradients -->
  <section id="top" class="relative overflow-hidden pt-16 pb-24 md:pb-32 bg-bg-base transition-colors duration-300">
    <!-- Ambient Floating Glow Blobs -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div class="glow-orb glow-yellow w-[400px] h-[400px] -left-32 top-10 opacity-20 dark:opacity-30 animate-float"></div>
      <div class="glow-orb glow-purple w-[500px] h-[500px] -right-32 top-[-50px] opacity-15 dark:opacity-25 animate-float-reverse"></div>
      <div class="glow-orb glow-cyan w-[300px] h-[300px] bottom-10 left-[35%] opacity-12 dark:opacity-20 animate-float"></div>
    </div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col lg:flex-row items-center gap-16 pt-6">
        
        <!-- Left: Taglines, Headline with Gradient, Pill CTA buttons -->
        <div class="lg:w-1/2 space-y-7 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 bg-brand-primary/10 dark:bg-brand-accent/5 border border-brand-primary/20 dark:border-brand-accent/20 px-4.5 py-2 rounded-full text-xs font-display font-extrabold uppercase tracking-widest text-brand-primary dark:text-brand-accent shadow-sm animate-pulse">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-primary dark:bg-brand-accent animate-ping"></span>
            <span>Trần Nhôm Gia Huy Nha Trang</span>
          </div>
          
          <h1 class="text-4xl sm:text-5xl xl:text-6xl font-display font-black leading-[1.1] tracking-tight uppercase text-text-base">
            Giải pháp <br>
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-primary via-brand-orange to-brand-accent">
              Trần & Vách Hiện Đại
            </span>
          </h1>
          
          <p class="text-text-muted text-base sm:text-lg leading-relaxed max-w-lg mx-auto lg:mx-0 font-medium">
            Thiết kế sáng tạo và thi công trọn gói hệ trần nhôm vân gỗ chống nước, trần thạch cao chống ẩm Knauf Đức, lam sóng gỗ nhựa trang trí cao cấp tại Khánh Hòa.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
            <a href="#lien-he" class="inline-flex items-center justify-center bg-gradient-to-r from-brand-primary to-brand-orange hover:shadow-xl hover:shadow-brand-primary/25 hover:-translate-y-0.5 text-white font-display font-extrabold text-sm px-8 py-4 rounded-full transition-all duration-300 shine-effect cursor-pointer w-full sm:w-auto text-center border border-white/20 shadow-md">
              <i class="fa-solid fa-file-invoice-dollar mr-2 text-base"></i> ĐĂNG KÝ BÁO GIÁ
            </a>
            <a href="tel:0935373577" class="inline-flex items-center justify-center border border-brand-primary/30 dark:border-white/10 hover:border-brand-primary text-brand-primary dark:text-brand-accent bg-card-bg/40 hover:bg-brand-primary/5 px-8 py-4 rounded-full font-display font-bold text-sm transition-all duration-300 backdrop-blur-md cursor-pointer w-full sm:w-auto text-center">
              <i class="fa-solid fa-phone mr-2"></i> GỌI TƯ VẤN 24/7
            </a>
          </div>
        </div>

        <!-- Right: Banner Image display in Glassmorphic rounded box -->
        <div class="lg:w-1/2 w-full relative">
          <!-- Colorful backdrop decoration -->
          <div class="absolute -inset-4 bg-gradient-to-r from-brand-accent via-brand-orange to-brand-green rounded-[2.5rem] blur-3xl opacity-25 dark:opacity-40 animate-pulse" style="animation-duration: 6s;"></div>
          
          <div class="glass-premium rounded-[2.5rem] p-4 relative overflow-hidden shadow-2xl transition-all duration-500 hover:-translate-y-2 hover:shadow-brand-primary/10 group border border-white/20 dark:border-white/10">
            <div class="flex items-center gap-1.5 pb-3 px-2 border-b border-stone-200/50 dark:border-white/10 mb-3 opacity-60">
              <span class="w-3 h-3 rounded-full bg-red-400"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
              <span class="w-3 h-3 rounded-full bg-green-400"></span>
            </div>
            <img 
              src="/banner.png" 
              alt="Banner Trần Nhôm Gia Huy" 
              class="w-full h-auto object-cover rounded-2xl border border-stone-200/50 dark:border-white/10"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Floating Capsule Trust Badge Bar -->
  <section class="relative z-20 -mt-16 mx-auto max-w-6xl px-4">
    <div class="glass-premium border border-stone-200/50 dark:border-white/10 shadow-2xl rounded-[2.5rem] grid grid-cols-1 md:grid-cols-3 gap-4 p-4 divide-y md:divide-y-0 md:divide-x divide-stone-200/40 dark:divide-white/5">
      
      <!-- Badge 1 -->
      <div class="p-6 flex items-center gap-4 hover:bg-brand-primary/5 transition-colors duration-300 rounded-[2rem] group cursor-pointer">
        <span class="grid size-12 place-items-center bg-brand-primary/10 text-brand-primary dark:text-brand-accent rounded-2xl text-xl shrink-0 group-hover:scale-110 transition-transform duration-300">
          <i class="fa-solid fa-shield-halved"></i>
        </span>
        <div>
          <h4 class="font-display font-extrabold text-sm uppercase tracking-wide text-text-base">Vật liệu cao cấp</h4>
          <p class="text-xs text-text-muted mt-0.5">Đạt chuẩn bền đẹp, chống ẩm mốc</p>
        </div>
      </div>

      <!-- Badge 2 -->
      <div class="p-6 flex items-center gap-4 hover:bg-brand-primary/5 transition-colors duration-300 rounded-[2rem] group cursor-pointer">
        <span class="grid size-12 place-items-center bg-brand-primary/10 text-brand-primary dark:text-brand-accent rounded-2xl text-xl shrink-0 group-hover:scale-110 transition-transform duration-300">
          <i class="fa-solid fa-screwdriver-wrench"></i>
        </span>
        <div>
          <h4 class="font-display font-extrabold text-sm uppercase tracking-wide text-text-base">Thi công tỉ mỉ</h4>
          <p class="text-xs text-text-muted mt-0.5">Đúng kỹ thuật, đội thợ tay nghề cao</p>
        </div>
      </div>

      <!-- Badge 3 -->
      <div class="p-6 flex items-center gap-4 hover:bg-brand-primary/5 transition-colors duration-300 rounded-[2rem] group cursor-pointer">
        <span class="grid size-12 place-items-center bg-brand-primary/10 text-brand-primary dark:text-brand-accent rounded-2xl text-xl shrink-0 group-hover:scale-110 transition-transform duration-300">
          <i class="fa-solid fa-award"></i>
        </span>
        <div>
          <h4 class="font-display font-extrabold text-sm uppercase tracking-wide text-text-base">Báo giá tại xưởng</h4>
          <p class="text-xs text-text-muted mt-0.5">Không trung gian, tối ưu 20% chi phí</p>
        </div>
      </div>

    </div>
  </section>

  <!-- Giới Thiệu / Vị Trí Hoạt Động -->
  <section id="gioi-thieu" class="py-24 lg:py-32 relative overflow-hidden bg-bg-base transition-colors duration-300">
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div class="glow-orb glow-green w-[300px] h-[300px] -left-20 bottom-10 opacity-10 dark:opacity-15 animate-float"></div>
      <div class="glow-orb glow-yellow w-[300px] h-[300px] -right-20 bottom-20 opacity-10 dark:opacity-15 animate-float-reverse"></div>
    </div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        
        <!-- Left: Real project mockup -->
        <div class="lg:w-1/2 w-full">
          <div class="relative p-2 rounded-[2.5rem] border border-stone-200/60 dark:border-white/10 bg-card-bg shadow-2xl">
            <!-- Glass Overlay address card -->
            <div class="absolute bottom-6 left-6 right-6 z-10 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border border-stone-200/50 dark:border-white/10 text-text-base p-5 rounded-2xl shadow-xl flex items-center gap-4">
              <div class="size-11 bg-brand-primary/15 dark:bg-brand-accent/20 rounded-full flex items-center justify-center text-brand-primary dark:text-brand-accent text-xl shrink-0 animate-bounce">
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <div>
                <h4 class="font-display font-extrabold text-[10px] uppercase tracking-wider text-text-muted">Khu vực hoạt động</h4>
                <p class="text-sm font-extrabold text-text-base mt-0.5">Nha Trang - Khánh Hòa và lân cận</p>
              </div>
            </div>
            
            <img 
              src="/projects/project-5.png" 
              alt="Thi công trần nhôm Nha Trang" 
              class="w-full h-auto aspect-[4/3] rounded-[2.2rem] object-cover shadow-inner"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Right: Content details -->
        <div class="lg:w-1/2 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 bg-brand-primary/10 dark:bg-brand-accent/5 border border-brand-primary/20 dark:border-brand-accent/20 px-4 py-1.5 rounded-full">
            <p class="text-xs font-semibold text-brand-primary dark:text-brand-accent tracking-widest uppercase">
              Về thương hiệu Gia Huy
            </p>
          </div>
          
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-black text-text-base uppercase leading-tight">
            Chuyên gia thi công trần vách uy tín
          </h2>
          
          <div class="text-text-muted text-sm md:text-base leading-relaxed space-y-4 font-medium max-w-xl mx-auto lg:mx-0">
            <p>
              Gia Huy tự hào đồng hành cùng hàng trăm gia chủ và chủ đầu tư dự án tại Nha Trang, mang tới các sản phẩm **trần nhôm cao cấp, trần thạch cao, lam gỗ nhựa** bền bỉ dưới mọi khí hậu ven biển.
            </p>
            <p class="bg-gradient-to-r from-brand-primary/10 via-brand-orange/5 to-transparent p-4 border-l-4 border-brand-primary text-brand-primary-dark dark:text-brand-accent font-bold rounded-r-xl text-left">
              Chúng tôi sở hữu năng lực cung cấp trực tiếp vật tư chính hãng với giá cả gốc tại kho và cử thợ chuyên môn cao thi công trực tiếp không qua thầu phụ.
            </p>
            <p>
              Sự chính xác kỹ thuật, tính thẩm mỹ hoàn thiện cao và trách nhiệm bảo hành lâu dài là kim chỉ nam giúp Trần Nhôm Gia Huy khẳng định vị thế thương hiệu lâu đời trong ngành xây dựng hoàn thiện tại Khánh Hòa.
            </p>
          </div>
          
          <div class="pt-4 flex flex-wrap gap-4 justify-center lg:justify-start items-center">
            <div class="bg-card-bg border border-stone-200/50 dark:border-white/5 rounded-2xl px-6 py-4">
              <p class="text-[10px] uppercase font-bold text-text-muted">Hotline Zalo 24/7</p>
              <a href="tel:0935373577" class="text-xl font-display font-black text-brand-primary dark:text-brand-accent hover:text-brand-orange transition-colors">0935.37.3577</a>
            </div>
            <div class="bg-card-bg border border-stone-200/50 dark:border-white/5 rounded-2xl px-6 py-4">
              <p class="text-[10px] uppercase font-bold text-text-muted">Cam kết dịch vụ</p>
              <p class="text-sm font-display font-extrabold text-brand-green">ĐẸP - ĐÚNG TIẾN ĐỘ</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Marquee Banner between sections - Premium flow -->
  <section class="overflow-hidden border-y border-stone-200/50 dark:border-white/5 bg-stone-100/50 dark:bg-slate-900/60 py-6 transition-colors duration-300">
    <div class="marquee-container gap-12 whitespace-nowrap text-xs sm:text-sm font-display font-extrabold uppercase tracking-[0.2em] text-text-muted">
      <div class="marquee-content flex gap-12">
        <span class="hover:text-brand-primary dark:hover:text-brand-accent transition-colors duration-200">TRẦN NHÔM GIA HUY</span> <span class="text-stone-300 dark:text-white/20">•</span>
        <span class="hover:text-brand-orange transition-colors duration-200">UY TÍN - THI CÔNG NHANH</span> <span class="text-stone-300 dark:text-white/20">•</span>
        <span class="hover:text-brand-green transition-colors duration-200">BÁO GIÁ TẠI XƯỞNG</span> <span class="text-stone-300 dark:text-white/20">•</span>
        <span class="hover:text-brand-primary dark:hover:text-brand-accent transition-colors duration-200">TRẦN NHÔM VÂN GỖ</span> <span class="text-stone-300 dark:text-white/20">•</span>
        <span class="hover:text-brand-orange transition-colors duration-200">TRẦN THẠCH CAO KNAUF</span> <span class="text-stone-300 dark:text-white/20">•</span>
        <span class="hover:text-brand-green transition-colors duration-200">LAM SÓNG GIẢ GỖ CAO CẤP</span> <span class="text-stone-300 dark:text-white/20">•</span>
        
        <!-- Repeat content for continuous loop -->
        <span class="hover:text-brand-primary dark:hover:text-brand-accent transition-colors duration-200">TRẦN NHÔM GIA HUY</span> <span class="text-stone-300 dark:text-white/20">•</span>
        <span class="hover:text-brand-orange transition-colors duration-200">UY TÍN - THI CÔNG NHANH</span> <span class="text-stone-300 dark:text-white/20">•</span>
        <span class="hover:text-brand-green transition-colors duration-200">BÁO GIÁ TẠI XƯỞNG</span> <span class="text-stone-300 dark:text-white/20">•</span>
        <span class="hover:text-brand-primary dark:hover:text-brand-accent transition-colors duration-200">TRẦN NHÔM VÂN GỖ</span> <span class="text-stone-300 dark:text-white/20">•</span>
        <span class="hover:text-brand-orange transition-colors duration-200">TRẦN THẠCH CAO KNAUF</span> <span class="text-stone-300 dark:text-white/20">•</span>
        <span class="hover:text-brand-green transition-colors duration-200">LAM SÓNG GIẢ GỖ CAO CẤP</span>
      </div>
    </div>
  </section>

  <!-- Hạng Mục Thi Công - Bento style Glass Cards with top color stripes -->
  <section id="dich-vu" class="py-24 lg:py-32 relative overflow-hidden bg-bg-base transition-colors duration-300">
    <!-- Background glow -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div class="glow-orb glow-blue w-[400px] h-[400px] right-0 top-1/4 opacity-10 dark:opacity-15 animate-float"></div>
      <div class="glow-orb glow-yellow w-[300px] h-[300px] left-0 top-1/2 opacity-10 dark:opacity-15 animate-float-reverse"></div>
    </div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-20 space-y-4">
        <div class="inline-flex items-center gap-2 bg-brand-primary/10 dark:bg-brand-accent/5 border border-brand-primary/20 dark:border-brand-accent/20 px-4 py-1.5 rounded-full">
          <p class="text-xs font-semibold text-brand-primary dark:text-brand-accent tracking-widest uppercase">
            Hạng mục thi công cốt lõi
          </p>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-black text-text-base uppercase">
          Dịch vụ trọn gói từ Gia Huy
        </h2>
        <p class="text-text-muted text-sm font-medium max-w-xl mx-auto leading-relaxed">
          Chúng tôi trực tiếp nhập khẩu, phân phối và lắp đặt các hệ trần nhôm trang trí, trần thạch cao chất lượng đạt tiêu chuẩn thiết kế.
        </p>
      </div>

      <!-- Glass Cards Grid with Accent Stripes -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Card 1: Trần Thạch Cao -->
        <article class="glass-premium glowing-card group rounded-[2.5rem] overflow-hidden flex flex-col justify-between cursor-pointer">
          <!-- Top Accent Color Bar -->
          <div class="h-1.5 w-full bg-gradient-to-r from-brand-primary to-brand-accent"></div>
          
          <div class="p-8 space-y-6 flex-grow">
            <!-- Icon -->
            <div class="w-14 h-14 rounded-2xl bg-brand-primary/10 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
              <span class="text-brand-primary text-2xl font-bold">
                <i class="fa-solid fa-fill-drip"></i>
              </span>
            </div>
            <h3 class="font-display font-black text-xl text-text-base uppercase tracking-tight group-hover:text-brand-primary dark:group-hover:text-brand-accent transition-colors duration-200">Trần thạch cao</h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-medium">
              Thi công hệ trần phẳng, giật cấp thẩm mỹ cao, cách âm cách nhiệt tốt. Thích hợp cho phòng khách biệt thự, căn hộ cao cấp và văn phòng công sở.
            </p>
            <ul class="space-y-2.5 text-xs text-text-base font-bold border-t border-stone-200/50 dark:border-white/5 pt-5">
              <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-brand-green text-[10px]"></i> Tấm thạch cao Knauf Đức chống ẩm</li>
              <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-brand-green text-[10px]"></i> Khung xương Vĩnh Tường chịu lực</li>
              <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-brand-green text-[10px]"></i> Bề mặt bả sơn nhẵn mịn tuyệt đối</li>
            </ul>
          </div>
          
          <div class="p-8 pt-0">
            <a href="#lien-he" class="flex items-center justify-center gap-2 w-full py-3.5 bg-stone-100 dark:bg-slate-800 hover:bg-gradient-to-r hover:from-brand-primary hover:to-brand-orange hover:text-white hover:shadow-lg text-text-base dark:text-white font-display font-bold text-xs rounded-full transition-all duration-300">
              Nhận tư vấn & Báo giá
            </a>
          </div>
        </article>

        <!-- Card 2: Trần Nhôm - Lam Nhôm -->
        <article class="glass-premium glowing-card group rounded-[2.5rem] overflow-hidden flex flex-col justify-between cursor-pointer">
          <!-- Top Accent Color Bar -->
          <div class="h-1.5 w-full bg-gradient-to-r from-brand-accent to-brand-orange"></div>
          
          <div class="p-8 space-y-6 flex-grow">
            <!-- Icon -->
            <div class="w-14 h-14 rounded-2xl bg-brand-orange/10 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
              <span class="text-brand-orange text-2xl font-bold">
                <i class="fa-solid fa-bars-staggered"></i>
              </span>
            </div>
            <h3 class="font-display font-black text-xl text-text-base uppercase tracking-tight group-hover:text-brand-primary dark:group-hover:text-brand-accent transition-colors duration-200">Trần & Lam nhôm giả gỗ</h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-medium">
              Sản phẩm đỉnh cao kháng nước, chịu bức xạ mặt trời. Rất chuộng thi công sảnh đón ngoài trời, lam chắn nắng mặt tiền nhà hướng Tây.
            </p>
            <ul class="space-y-2.5 text-xs text-text-base font-bold border-t border-stone-200/50 dark:border-white/5 pt-5">
              <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-brand-green text-[10px]"></i> Nhôm tĩnh điện vân gỗ nổi cao cấp</li>
              <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-brand-green text-[10px]"></i> Kết cấu U-Shaped, Caro Cell sang trọng</li>
              <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-brand-green text-[10px]"></i> Không rỉ sét, chịu gió giật biển khơi</li>
            </ul>
          </div>
          
          <div class="p-8 pt-0">
            <a href="#lien-he" class="flex items-center justify-center gap-2 w-full py-3.5 bg-stone-100 dark:bg-slate-800 hover:bg-gradient-to-r hover:from-brand-primary hover:to-brand-orange hover:text-white hover:shadow-lg text-text-base dark:text-white font-display font-bold text-xs rounded-full transition-all duration-300">
              Nhận tư vấn & Báo giá
            </a>
          </div>
        </article>

        <!-- Card 3: Trần - Vách Nhựa Giả Gỗ -->
        <article class="glass-premium glowing-card group rounded-[2.5rem] overflow-hidden flex flex-col justify-between cursor-pointer">
          <!-- Top Accent Color Bar -->
          <div class="h-1.5 w-full bg-gradient-to-r from-brand-orange to-brand-green"></div>
          
          <div class="p-8 space-y-6 flex-grow">
            <!-- Icon -->
            <div class="w-14 h-14 rounded-2xl bg-brand-green/10 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
              <span class="text-brand-green text-2xl font-bold">
                <i class="fa-solid fa-layer-group"></i>
              </span>
            </div>
            <h3 class="font-display font-black text-xl text-text-base uppercase tracking-tight group-hover:text-brand-primary dark:group-hover:text-brand-accent transition-colors duration-200">Trần vách nhựa giả gỗ</h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-medium">
              Tấm nhựa ốp tường PVC nano vân đá, lam nhựa trang trí nội thất. Dễ dàng lau chùi vệ sinh, chi phí thi công kinh tế và sang trọng.
            </p>
            <ul class="space-y-2.5 text-xs text-text-base font-bold border-t border-stone-200/50 dark:border-white/5 pt-5">
              <li class="flex items-center gap-2.5"><i class="fa-solid fa-circle-check text-brand-green text-[10px]"></i> Vật liệu nhựa nguyên sinh cách nhiệt</li>
