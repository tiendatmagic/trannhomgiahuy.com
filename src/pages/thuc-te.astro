---
import Layout from "../layouts/Layout.astro";
import ProjectShowcase from "../components/ProjectShowcase.astro";

const pageTitle = "Dự Án Thực Tế & Quy Trình";
const pageSubtitle = "Thư viện tổng hợp hình ảnh hoàn thiện tại công trình và quy trình 5 bước thi công chuẩn mực của đội ngũ Trần Nhôm Gia Huy.";
---

<Layout title="Dự án thực tế & Quy trình thi công trần nhôm thạch cao - Gia Huy">
  <!-- Page Hero Banner - Blends with deep-brown Header -->
  <div class="relative pt-44 pb-24 md:pt-52 md:pb-32 bg-gradient-to-b from-brand-primary-deep via-stone-950/95 to-stone-950 text-white overflow-hidden border-b-2 border-brand-primary/25">
    <!-- Background visual - Parallax lines and blur orb -->
    <div class="absolute inset-0 z-0">
      <img
        src="/projects/project-2.png"
        alt="Thực tế Trần Nhôm Gia Huy"
        class="w-full h-full object-cover opacity-65 select-none pointer-events-none scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-tr from-stone-950/75 via-brand-primary-deep/30 to-brand-orange/25"></div>
      <div class="glow-orb glow-orange w-[300px] h-[300px] -left-20 top-[-20px] opacity-30 animate-float"></div>
      <div class="glow-orb glow-yellow w-[300px] h-[300px] -right-20 bottom-[-20px] opacity-25 animate-float-reverse"></div>
      <!-- Geometric accent lines -->
      <div class="absolute right-[10%] bottom-0 w-[1px] h-[150px] bg-gradient-to-t from-brand-primary to-transparent opacity-40 hidden md:block"></div>
      <div class="absolute right-[15%] bottom-0 w-[1px] h-[250px] bg-gradient-to-t from-brand-orange to-transparent opacity-20 hidden md:block"></div>
    </div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 text-center lg:text-left space-y-6">
      <nav class="flex justify-center lg:justify-start items-center gap-2 text-xs md:text-sm font-semibold tracking-widest uppercase text-white/50">
        <a href="/" class="hover:text-brand-accent transition-colors flex items-center gap-1"><i class="fa-solid fa-house text-[10px]"></i> Trang chủ</a>
        <span class="text-white/30">•</span>
        <span class="text-brand-accent">Dự án &amp; Quy trình</span>
      </nav>
      <div class="max-w-full space-y-4">
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-display font-black uppercase tracking-tight leading-tight text-white max-w-full">
          {pageTitle}
        </h1>
        <p class="text-sm md:text-lg text-white/80 font-medium leading-relaxed max-w-2xl">
          {pageSubtitle}
        </p>
      </div>
    </div>
  </div>

  <!-- Showcase Portfolio Section - Generous spacing and Glow Orbs -->
  <section
    id="thu-vien"
    class="py-12 md:py-[60px] relative overflow-hidden bg-bg-base"
  >
    <!-- Background Glow Orbs for Depth -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div class="glow-orb glow-yellow w-[450px] h-[450px] -left-32 top-10 opacity-12 animate-float"></div>
      <div class="glow-orb glow-orange w-[400px] h-[400px] -right-32 bottom-10 opacity-10 animate-float-reverse"></div>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Section Header -->
      <div
        class="text-center max-w-3xl mx-auto mb-16 space-y-4 reveal-on-scroll"
      >
        <div
          class="inline-flex items-center gap-2 bg-brand-primary/10 border border-brand-primary/20 px-4 py-1.5 rounded-full"
        >
          <p
            class="text-xs font-semibold text-brand-primary tracking-widest uppercase"
          >
            Nhật ký công trình Nha Trang
          </p>
        </div>
        <h2
          class="text-2xl sm:text-3xl lg:text-4xl font-display font-extrabold text-text-base uppercase"
        >
          BỘ SƯU TẬP DỰ ÁN HOÀN THIỆN
        </h2>
      </div>

      <!-- Showcase Portfolio component -->
      <ProjectShowcase />
    </div>
  </section>

  <!-- Project Classification - Geometric Glassmorphic Cards -->
  <section class="py-12 md:py-[60px] bg-bg-base transition-colors duration-300 border-t border-stone-200/40 relative overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-4 reveal-on-scroll">
        <div class="inline-flex items-center gap-2 bg-brand-orange/10 border border-brand-orange/20 px-4 py-1.5 rounded-full">
          <span class="text-xs font-semibold text-brand-orange uppercase">Đa dạng phân khúc</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-extrabold text-text-base uppercase">
          CÁC PHÂN KHÚC CÔNG TRÌNH TIÊU BIỂU
        </h2>
      </div>

      <!-- Staggered Layout with Glassmorphic Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Villa biệt thự -->
        <div class="bg-white/90 backdrop-blur-md border border-stone-200/50 p-8 rounded-[2.5rem] space-y-5 hover:shadow-2xl hover:border-brand-primary/40 transition-all duration-300 group hover:-translate-y-1 relative overflow-hidden border-b-2 border-b-brand-primary reveal-on-scroll">
          <span class="absolute right-4 top-2 text-6xl font-display font-black text-stone-100/50 group-hover:text-brand-primary/5 select-none transition-colors z-0">01</span>
          <div class="size-12 rounded-2xl bg-brand-primary/10 text-brand-primary flex items-center justify-center text-xl relative z-10 group-hover:bg-brand-primary group-hover:text-white transition-all duration-300">
            <i class="fa-solid fa-hotel"></i>
          </div>
          <div class="space-y-2 relative z-10">
            <h4 class="font-display font-extrabold text-base text-text-base uppercase">Villa &amp; Biệt thự biển</h4>
            <p class="text-xs sm:text-sm text-text-muted font-medium leading-relaxed">
              Thi công sảnh ngoài trời lam nhôm U-Shaped vân gỗ tĩnh điện vững chãi, chống chọi muối mặn và gió lốc của vùng biển.
            </p>
          </div>
        </div>

        <!-- Nhà phố hiện đại -->
        <div class="bg-white/90 backdrop-blur-md border border-stone-200/50 p-8 rounded-[2.5rem] space-y-5 hover:shadow-2xl hover:border-brand-orange/40 transition-all duration-300 group hover:-translate-y-1 relative overflow-hidden border-t-2 border-t-brand-orange reveal-on-scroll delay-100">
          <span class="absolute right-4 top-2 text-6xl font-display font-black text-stone-100/50 group-hover:text-brand-orange/5 select-none transition-colors z-0">02</span>
          <div class="size-12 rounded-2xl bg-brand-orange/10 text-brand-orange flex items-center justify-center text-xl relative z-10 group-hover:bg-brand-orange group-hover:text-white transition-all duration-300">
            <i class="fa-solid fa-house-chimney"></i>
          </div>
          <div class="space-y-2 relative z-10">
            <h4 class="font-display font-extrabold text-base text-text-base uppercase">Nhà phố hiện đại</h4>
            <p class="text-xs sm:text-sm text-text-muted font-medium leading-relaxed">
              Các mẫu trần thạch cao phẳng kết hợp giật cấp, ốp vách lam sóng nhựa trang trí mang lại không gian sống ấm áp, tinh tế.
            </p>
          </div>
        </div>

        <!-- Căn hộ chung cư -->
        <div class="bg-white/90 backdrop-blur-md border border-stone-200/50 p-8 rounded-[2.5rem] space-y-5 hover:shadow-2xl hover:border-brand-green/40 transition-all duration-300 group hover:-translate-y-1 relative overflow-hidden border-b-2 border-b-brand-green reveal-on-scroll delay-200">
          <span class="absolute right-4 top-2 text-6xl font-display font-black text-stone-100/50 group-hover:text-brand-green/5 select-none transition-colors z-0">03</span>
          <div class="size-12 rounded-2xl bg-brand-green/10 text-brand-green flex items-center justify-center text-xl relative z-10 group-hover:bg-brand-green group-hover:text-white transition-all duration-300">
            <i class="fa-solid fa-building"></i>
          </div>
          <div class="space-y-2 relative z-10">
            <h4 class="font-display font-extrabold text-base text-text-base uppercase">Căn hộ chung cư</h4>
            <p class="text-xs sm:text-sm text-text-muted font-medium leading-relaxed">
              Tối ưu hóa diện tích cốt trần bằng hệ trần thạch cao phẳng kết hợp chạy LED hiện đại, giấu kín đường ống gió điều hòa.
            </p>
          </div>
        </div>

        <!-- Showroom cafe -->
        <div class="bg-white/90 backdrop-blur-md border border-stone-200/50 p-8 rounded-[2.5rem] space-y-5 hover:shadow-2xl hover:border-brand-blue/40 transition-all duration-300 group hover:-translate-y-1 relative overflow-hidden border-t-2 border-t-brand-blue reveal-on-scroll delay-300">
          <span class="absolute right-4 top-2 text-6xl font-display font-black text-stone-100/50 group-hover:text-brand-blue/5 select-none transition-colors z-0">04</span>
          <div class="size-12 rounded-2xl bg-brand-blue/10 text-brand-blue flex items-center justify-center text-xl relative z-10 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300">
            <i class="fa-solid fa-store"></i>
          </div>
          <div class="space-y-2 relative z-10">
            <h4 class="font-display font-extrabold text-base text-text-base uppercase">Showroom, Cafe &amp; Spa</h4>
            <p class="text-xs sm:text-sm text-text-muted font-medium leading-relaxed">
              Tạo hình trần caro (cell) nhôm mở hoặc các vách PVC vân đá cẩm thạch thu hút mọi góc nhìn thị giác của khách hàng.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline Flow Section - Geometric Connecting Lines (Flowchart) -->
  <section class="py-12 md:py-[60px] relative overflow-hidden bg-bg-base border-t border-stone-200/40">
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div class="glow-orb glow-yellow w-[450px] h-[450px] -left-32 top-10 opacity-12 animate-float"></div>
      <div class="glow-orb glow-orange w-[400px] h-[400px] -right-32 top-1/2 opacity-10 animate-float-reverse"></div>
      <div class="glow-orb glow-green w-[300px] h-[300px] bottom-10 left-[35%] opacity-8 animate-float"></div>
    </div>

    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto mb-20 space-y-4 reveal-on-scroll">
        <div class="inline-flex items-center gap-2 bg-brand-primary/10 border border-brand-primary/20 px-4 py-1.5 rounded-full">
          <p class="text-xs font-semibold text-brand-primary tracking-widest uppercase">Phối hợp chặt chẽ</p>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-extrabold text-text-base uppercase">
          5 BƯỚC THI CÔNG KỸ THUẬT
        </h2>
      </div>

      <!-- Connecting flowchart vertical line with circles -->
      <div class="relative border-l-2 border-dashed border-brand-primary/30 ml-4 sm:ml-8 pl-8 sm:pl-12 space-y-16">
        
        <!-- Step 1 -->
        <article class="relative group reveal-on-scroll">
          <!-- Step indicator dot -->
          <span class="absolute -left-[52px] sm:left-[-72px] top-2.5 size-10 sm:size-12 rounded-full bg-gradient-to-r from-brand-primary to-brand-orange border-4 border-white shadow-lg flex items-center justify-center font-display font-black text-xs sm:text-sm text-white group-hover:scale-110 transition-transform duration-300 z-10">1</span>
          
          <div class="bg-white/90 backdrop-blur-xl border border-stone-200/50 p-6 sm:p-8 rounded-[2.5rem] shadow-xl space-y-3 relative hover:border-brand-primary/50 hover:shadow-[0_20px_50px_rgba(217,119,6,0.12)] transition-all duration-300">
            <span class="text-xs font-semibold text-brand-primary-dark bg-brand-primary/10 px-3 py-1 rounded-full w-fit">1 - 2 Ngày</span>
            <h3 class="font-display font-extrabold text-lg sm:text-xl text-text-base uppercase tracking-tight">
              Khảo sát đo đạc hiện trạng
            </h3>
            <p class="text-xs sm:text-sm lg:text-base text-text-muted leading-relaxed font-medium">
              Kỹ sư đến khảo sát trực tiếp tại Nha Trang để kiểm tra độ sụt cốt trần, đo đạc kích thước thực tế, xác định các điểm dầm chịu lực và cốt tường ẩm mốc.
            </p>
            <div class="text-[11px] sm:text-xs text-brand-orange font-bold uppercase tracking-wider pt-2 border-t border-stone-200/40 flex items-center gap-1.5">
              <i class="fa-solid fa-circle-info"></i>
              <span>Khách hàng: Cung cấp yêu cầu ý tưởng &amp; liên kết điện nước</span>
            </div>
          </div>
        </article>

        <!-- Step 2 -->
        <article class="relative group reveal-on-scroll delay-100">
          <!-- Step indicator dot -->
          <span class="absolute -left-[52px] sm:left-[-72px] top-2.5 size-10 sm:size-12 rounded-full bg-gradient-to-r from-brand-primary to-brand-orange border-4 border-white shadow-lg flex items-center justify-center font-display font-black text-xs sm:text-sm text-white group-hover:scale-110 transition-transform duration-300 z-10">2</span>
          
          <div class="bg-white/90 backdrop-blur-xl border border-stone-200/50 p-6 sm:p-8 rounded-[2.5rem] shadow-xl space-y-3 relative hover:border-brand-primary/50 hover:shadow-[0_20px_50px_rgba(217,119,6,0.12)] transition-all duration-300">
            <span class="text-xs font-semibold text-brand-primary-dark bg-brand-primary/10 px-3 py-1 rounded-full w-fit">1 Ngày</span>
            <h3 class="font-display font-extrabold text-lg sm:text-xl text-text-base uppercase tracking-tight">
              Lập bản vẽ phân bổ khung xương
            </h3>
            <p class="text-xs sm:text-sm lg:text-base text-text-muted leading-relaxed font-medium">
              Xây dựng bản vẽ định vị hệ ty treo, phân bổ khẩu độ xương cá xương phụ và tấm trần thạch cao/nhôm tĩnh điện vân gỗ theo tiêu chuẩn kỹ thuật an toàn của hãng.
            </p>
            <div class="text-[11px] sm:text-xs text-brand-orange font-bold uppercase tracking-wider pt-2 border-t border-stone-200/40 flex items-center gap-1.5">
              <i class="fa-solid fa-circle-info"></i>
              <span>Khách hàng: Thống nhất độ dày nhôm (0.5 - 0.7mm) và sơ đồ giật cấp</span>
            </div>
          </div>
        </article>

        <!-- Step 3 -->
        <article class="relative group reveal-on-scroll delay-200">
          <!-- Step indicator dot -->
          <span class="absolute -left-[52px] sm:left-[-72px] top-2.5 size-10 sm:size-12 rounded-full bg-gradient-to-r from-brand-primary to-brand-orange border-4 border-white shadow-lg flex items-center justify-center font-display font-black text-xs sm:text-sm text-white group-hover:scale-110 transition-transform duration-300 z-10">3</span>
          
          <div class="bg-white/90 backdrop-blur-xl border border-stone-200/50 p-6 sm:p-8 rounded-[2.5rem] shadow-xl space-y-3 relative hover:border-brand-primary/50 hover:shadow-[0_20px_50px_rgba(217,119,6,0.12)] transition-all duration-300">
            <span class="text-xs font-semibold text-brand-primary-dark bg-brand-primary/10 px-3 py-1 rounded-full w-fit">1 Ngày</span>
            <h3 class="font-display font-extrabold text-lg sm:text-xl text-text-base uppercase tracking-tight">
              Báo giá, Ký hợp đồng &amp; Tập kết
            </h3>
            <p class="text-xs sm:text-sm lg:text-base text-text-muted leading-relaxed font-medium">
              Dự toán bóc tách chi tiết khối lượng, ký kết hợp đồng thi công trọn gói cam kết không phát sinh. Tập kết vật tư chính hãng nguyên hộp về chân công trình.
            </p>
            <div class="text-[11px] sm:text-xs text-brand-orange font-bold uppercase tracking-wider pt-2 border-t border-stone-200/40 flex items-center gap-1.5">
              <i class="fa-solid fa-circle-info"></i>
              <span>Khách hàng: Chuẩn bị kho bãi khô ráo để lưu trữ vật tư tạm thời</span>
            </div>
          </div>
        </article>

        <!-- Step 4 -->
        <article class="relative group reveal-on-scroll delay-300">
          <!-- Step indicator dot -->
          <span class="absolute -left-[52px] sm:left-[-72px] top-2.5 size-10 sm:size-12 rounded-full bg-gradient-to-r from-brand-primary to-brand-orange border-4 border-white shadow-lg flex items-center justify-center font-display font-black text-xs sm:text-sm text-white group-hover:scale-110 transition-transform duration-300 z-10">4</span>
          
          <div class="bg-white/90 backdrop-blur-xl border border-stone-200/50 p-6 sm:p-8 rounded-[2.5rem] shadow-xl space-y-3 relative hover:border-brand-primary/50 hover:shadow-[0_20px_50px_rgba(217,119,6,0.12)] transition-all duration-300">
            <span class="text-xs font-semibold text-brand-primary-dark bg-brand-primary/10 px-3 py-1 rounded-full w-fit">3 - 5 Ngày</span>
            <h3 class="font-display font-extrabold text-lg sm:text-xl text-text-base uppercase tracking-tight">
              Lắp dựng kết cấu khung xương
            </h3>
            <p class="text-xs sm:text-sm lg:text-base text-text-muted leading-relaxed font-medium">
              Lắp dựng ty treo đạn nở sắt, định vị khung xương cá bằng máy laser chính xác, bắn vít cố định tấm thạch cao hoặc cài ghép tấm trần nhôm khớp nối trơn tru.
            </p>
            <div class="text-[11px] sm:text-xs text-brand-orange font-bold uppercase tracking-wider pt-2 border-t border-stone-200/40 flex items-center gap-1.5">
              <i class="fa-solid fa-circle-info"></i>
              <span>Khách hàng: Giám sát tiến độ lắp đặt phần xương thô trước khi bắn tấm</span>
            </div>
          </div>
        </article>

        <!-- Step 5 -->
        <article class="relative group reveal-on-scroll delay-400">
          <!-- Step indicator dot -->
          <span class="absolute -left-[52px] sm:left-[-72px] top-2.5 size-10 sm:size-12 rounded-full bg-gradient-to-r from-brand-primary to-brand-orange border-4 border-white shadow-lg flex items-center justify-center font-display font-black text-xs sm:text-sm text-white group-hover:scale-110 transition-transform duration-300 z-10">5</span>
          
          <div class="bg-white/90 backdrop-blur-xl border border-stone-200/50 p-6 sm:p-8 rounded-[2.5rem] shadow-xl space-y-3 relative hover:border-brand-primary/50 hover:shadow-[0_20px_50px_rgba(217,119,6,0.12)] transition-all duration-300">
            <span class="text-xs font-semibold text-brand-green bg-brand-green/10 px-3 py-1 rounded-full w-fit">1 Ngày</span>
            <h3 class="font-display font-extrabold text-lg sm:text-xl text-text-base uppercase tracking-tight">
              Bả sơn hoàn thiện &amp; Nghiệm thu
            </h3>
            <p class="text-xs sm:text-sm lg:text-base text-text-muted leading-relaxed font-medium">
              Trét mối nối lưới thạch cao bằng bột bả chuyên dụng chống nứt, tiến hành xả nhám phẳng láng và lăn sơn Dulux hoàn thiện. Nghiệm thu bàn giao phiếu bảo hành kết cấu.
            </p>
            <div class="text-[11px] sm:text-xs text-brand-orange font-bold uppercase tracking-wider pt-2 border-t border-stone-200/40 flex items-center gap-1.5">
              <i class="fa-solid fa-circle-info"></i>
              <span>Khách hàng: Đo đạc nghiệm thu khối lượng thực tế và nhận bàn giao sử dụng</span>
            </div>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- FAQ Section - Clean Accordion disclosure design -->
  <section class="py-12 md:py-[60px] bg-bg-base border-t border-stone-200/40 relative overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
      <div class="glow-orb glow-green w-[300px] h-[300px] left-[-50px] top-[10px] opacity-8 animate-float"></div>
      <div class="glow-orb glow-yellow w-[300px] h-[300px] right-[-50px] bottom-[10px] opacity-8 animate-float-reverse"></div>
    </div>
    
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-4 reveal-on-scroll">
        <div class="inline-flex items-center gap-2 bg-brand-green/10 border border-brand-green/20 px-4 py-1.5 rounded-full">
          <span class="text-xs font-semibold text-brand-green uppercase">Giải đáp chuyên môn</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-extrabold text-text-base uppercase">
          CÂU HỎI THƯỜNG GẶP KHI THI CÔNG
        </h2>
      </div>

      <!-- Clean disclosures list (Accordions) -->
      <div class="space-y-4 max-w-3xl mx-auto">
        <!-- FAQ 1 -->
        <details class="group bg-white/90 backdrop-blur-xl border border-stone-200/50 rounded-[2.5rem] overflow-hidden [&_summary::-webkit-details-marker]:hidden transition-all duration-300 shadow-sm hover:shadow-md hover:border-brand-primary/30 reveal-on-scroll">
          <summary class="flex items-center justify-between p-6 sm:p-8 text-text-base font-display font-bold text-sm sm:text-base uppercase tracking-tight cursor-pointer select-none group-open:bg-brand-primary/5 transition-colors">
            <span>Thời gian hoàn thiện trần thạch cao phòng khách thông thường bao lâu?</span>
            <span class="transition-transform duration-300 group-open:rotate-180 text-brand-primary">
              <i class="fa-solid fa-chevron-down"></i>
            </span>
          </summary>
          <div class="px-6 sm:px-8 pb-6 sm:pb-8 pt-4 text-xs sm:text-sm lg:text-base text-text-muted leading-relaxed font-medium border-t border-stone-200/30">
